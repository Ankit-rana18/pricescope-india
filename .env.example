# PriceScope India — example environment.
# Copy to `.env` and fill in values. Never commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser: put NO secrets there.

# ---------------------------------------------------------------- general
# development | test | production
PRICESCOPE_ENV=development
# true = all marketplaces use clearly labelled mock data. Never mixed with live data.
PRICESCOPE_DEMO_MODE=true
PRICESCOPE_LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins.
PRICESCOPE_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- storage
# sheets   = interim primary store: one tab per table in a Google spreadsheet (default)
# postgres = PostgreSQL via SQLAlchemy (same schema, same rules)
PRICESCOPE_STORAGE_BACKEND=sheets
# The long id in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
PRICESCOPE_GOOGLE_SHEETS_SPREADSHEET_ID=
# Service-account key: EITHER a file path (local dev; keep it under secrets/, git-ignored)
PRICESCOPE_GOOGLE_SERVICE_ACCOUNT_FILE=
# ...OR the key JSON itself on one line (Docker, Render, AWS). Never commit either.
PRICESCOPE_GOOGLE_SERVICE_ACCOUNT_JSON=
PRICESCOPE_SHEETS_CACHE_TTL_SECONDS=10

# India Post PIN directory CSV (open data from data.gov.in). Empty = only the PIN format
# is checked and the UI says so. Kept as a local file, not in Sheets (about 155k rows).
PRICESCOPE_PINCODE_DIRECTORY_FILE=

# ---------------------------------------------------------------- database / cache
# Only used when PRICESCOPE_STORAGE_BACKEND=postgres.
POSTGRES_USER=pricescope
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=pricescope
# Host-side URL (local dev outside Docker). docker-compose overrides the host to `postgres`.
PRICESCOPE_DATABASE_URL=postgresql+psycopg://pricescope:change-me-local-only@127.0.0.1:5432/pricescope
PRICESCOPE_REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------- auth (Supabase)
# dev = local-only labelled dev auth, refused when PRICESCOPE_ENV=production.
PRICESCOPE_AUTH_MODE=dev
PRICESCOPE_SUPABASE_URL=
PRICESCOPE_SUPABASE_JWT_AUDIENCE=authenticated
# Only for projects still on the legacy shared HS256 secret; leave empty to use the
# project's public signing keys (JWKS), which is the default and preferred.
PRICESCOPE_SUPABASE_JWT_SECRET=
# Emails that are made admin on first sign-in (comma-separated). Roles can then be
# changed from the admin dashboard, and every change is written to the audit log.
PRICESCOPE_ADMIN_EMAILS=

# ---------------------------------------------------------------- comparisons
# threads = in-process (no Redis needed); celery = workers via Redis (docker compose up worker)
PRICESCOPE_TASK_EXECUTOR=threads

# ---------------------------------------------------------------- marketplace integrations
# Leave blank until you have legitimate, approved credentials. Blank = NOT_CONFIGURED.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_ASSOCIATE_TAG=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Blinkit / Zepto / BigBasket: no public API. Configure a licensed provider here when chosen.
QUICK_COMMERCE_PROVIDER=
QUICK_COMMERCE_PROVIDER_API_KEY=

# ---------------------------------------------------------------- optional AI match review (off by default)
# Claude reviews only ambiguous (probable / unverified) candidates. It can raise a result to
# PROBABLE at most and never makes one EXACT. Costs API tokens; sends product data only.
PRICESCOPE_LLM_REVIEW_ENABLED=false
PRICESCOPE_LLM_REVIEW_MODEL=claude-opus-5-5
PRICESCOPE_LLM_REVIEW_MAX_PER_COMPARISON=6
PRICESCOPE_LLM_REVIEW_TIMEOUT_SECONDS=12
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- frontend (public, browser-visible)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
